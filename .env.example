# Scientific document embedding model
SIL_MODEL=sentence-transformers/allenai-specter
SIL_INBOX=data/inbox
SIL_PROCESSED=data/processed
SIL_DB=data/silab.sqlite3
SIL_ARTIFACTS=artifacts
SIL_REPORTS=reports
SIL_MAX_PAGES=80
SIL_MAX_KEYWORD_CHARS=60000
SIL_MAX_EMBEDDING_CHARS=12000
SIL_KEYWORD_TOP_N=25
SIL_CPU_WORKERS=2

# Optional Neo4j graph database connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
